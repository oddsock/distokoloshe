# ── Domain ──────────────────────────────────────────────
# Required for TLS certificates and TURN server
DOMAIN=distokoloshe.example.com
ACME_EMAIL=admin@example.com

# ── LiveKit ─────────────────────────────────────────────
LIVEKIT_API_KEY=CHANGE_ME_run_scripts_init_sh
LIVEKIT_API_SECRET=CHANGE_ME_run_scripts_init_sh

# ── App Auth ────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_run_scripts_init_sh
# E2EE_SECRET: legacy, not needed for new installs. Rooms now get random keys stored
# in the database; on an existing install keep your old value so rooms created before
# the change keep their key until it next rotates.

# ── Server Info ─────────────────────────────────────────
# Shown in the connection card on the signal bars. Without it, the API looks up the city
# of its own public IP once (ipinfo.io — only the server's IP is sent), caches it and
# shows "≈ City — estimated from the server's IP"; it asks again only if the IP changes.
# SERVER_CITY=Cape Town
# SERVER_GEO=off   # don't look the location up at all

# ── Desktop Auto-Updater ──────────────────────────────────
# GitHub repo for automatic release sync (optional)
# Set this to have the server auto-download new desktop releases
# GITHUB_REPO=youruser/distokoloshe
# GITHUB_TOKEN=ghp_xxx   # only needed for private repos

# ── Music Bot ──────────────────────────────────────────────
# Room name the DJ Tokoloshe bot joins (optional, default: Music)
# MUSIC_ROOM_NAME=Music

# ── Ports ────────────────────────────────────────────────
# Dev defaults (avoids conflicts with other services):
# WEB_PORT=3080
# WEB_TLS_PORT=3443
# LK_PORT=7881
#
# Production (set by init-certs.sh automatically):
# WEB_PORT=80
# WEB_TLS_PORT=443
